# ---------------------------------------------------------------------------
# Honni AI — environment variables
# Copy this file to `.env.local` and fill in what you need.
# `.env.local` is git-ignored. NEVER commit real keys.
# The app runs fully in DEMO MODE when nothing here is configured.
# ---------------------------------------------------------------------------

# --- AI provider (server-side only, never exposed to the browser) ------------
# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model used for chat + recipe generation
ANTHROPIC_MODEL=claude-sonnet-5
# Model used for photo analysis (vision capable)
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# Optional OpenAI-compatible fallback. Used only if ANTHROPIC_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Accounts & cross-device sync -------------------------------------------
# A Redis-compatible KV store (Upstash, or Vercel Marketplace → Upstash Redis).
# When these exist, accounts live on the server and favorites, plans, history
# and shopping lists follow the user across devices.
# Without them the app still works, but each browser keeps its own account.
# Vercel injects these automatically when you attach the integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash's own variable names are accepted as well:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Rate limiting (server side, per IP) ------------------------------------
AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60

# --- Uploads ----------------------------------------------------------------
# Max image size accepted by /api/analyze, in megabytes.
MAX_IMAGE_MB=8

# --- Branding (optional) ----------------------------------------------------
NEXT_PUBLIC_APP_NAME=Honni AI
NEXT_PUBLIC_SITE_URL=http://localhost:3000
