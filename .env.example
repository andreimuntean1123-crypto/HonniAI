# ---------------------------------------------------------------------------
# Honni AI — environment variables
# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is git-ignored. NEVER commit real keys.
# The app runs fully in DEMO MODE when nothing here is configured.
# ---------------------------------------------------------------------------

# --- AI provider (server-side only, never exposed to the browser) ------------
# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model used for chat + recipe generation
ANTHROPIC_MODEL=claude-sonnet-5
# Model used for photo analysis (vision capable)
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# Optional OpenAI-compatible fallback. Used only if ANTHROPIC_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Rate limiting (server side, per IP) ------------------------------------
AI_RATE_LIMIT_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60

# --- Uploads ----------------------------------------------------------------
# Max image size accepted by /api/analyze, in megabytes.
MAX_IMAGE_MB=8

# --- Google Sign-In (optional) ----------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console
# and add your origin (e.g. http://localhost:3000) to "Authorized JavaScript origins".
# When empty, the Google button falls back to the demo account.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Branding (optional) ----------------------------------------------------
NEXT_PUBLIC_APP_NAME=Honni AI
NEXT_PUBLIC_SITE_URL=http://localhost:3000
